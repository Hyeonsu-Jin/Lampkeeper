<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <!-- M1 개발용 로비·접속 화면. SCR-004(메인 메뉴)의 M1 최소판과 SCR-012(참가 중·참가 실패)를 한 UIDocument에 담는다.
         글자는 DevLobbyView가 텍스트 키로 채운다(NFR-034). 색·글자 크기는 Base.uss 변수만 쓴다. -->
    <Style src="project://database/Assets/_Game/UI/Screens/DevLobby.uss" />
    <ui:VisualElement name="root" class="screen-backdrop">
        <!-- 로비 패널 -->
        <ui:VisualElement name="lobby-panel" class="modal modal--wide">
            <ui:Label name="lobby-title" class="modal__title" />
            <ui:Label name="lobby-desc" class="modal__body" />
            <ui:Label name="lobby-status" class="modal__status" />
            <ui:VisualElement name="lobby-actions" class="modal__actions modal__actions--start">
                <ui:Button name="host" class="btn btn--primary" focusable="true" />
                <ui:Button name="refresh" class="btn" focusable="true" />
                <ui:Button name="invite" class="btn" focusable="true" />
                <ui:Button name="leave" class="btn" focusable="true" />
            </ui:VisualElement>
            <ui:Label name="list-state" class="text-dim" />
            <ui:ScrollView name="lobby-list" class="lobby-list" />
            <!-- 게임 버전 한 줄(SDD 3.7.12 (6)). 글자는 데이터라 텍스트 키를 거치지 않는다. -->
            <ui:Label name="lobby-version" class="text-dim" />
        </ui:VisualElement>

        <!-- 참가 중 패널 (SCR-012 ① 단계 목록, ② 진행 막대, ③ 취소) -->
        <ui:VisualElement name="connect-panel" class="modal modal--wide is-hidden">
            <ui:Label name="connect-title" class="modal__title" />
            <ui:Label name="step-host" class="text-body" />
            <ui:Label name="step-info" class="text-body" />
            <ui:Label name="step-world" class="text-body" />
            <ui:Label name="step-apply" class="text-body" />
            <ui:VisualElement class="gauge connect-gauge">
                <ui:VisualElement name="connect-fill" class="gauge__fill" />
            </ui:VisualElement>
            <ui:VisualElement class="modal__actions">
                <ui:Button name="connect-cancel" class="btn" focusable="true" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 참가 실패 패널 (SCR-012 ④ 제목, ⑤ 원인, ⑥ 해결, ⑦ 확인) -->
        <ui:VisualElement name="fail-panel" class="modal modal--wide is-hidden">
            <ui:Label name="fail-title" class="modal__title status--danger" />
            <ui:Label name="fail-cause" class="modal__body" />
            <ui:Label name="fail-fix" class="modal__body" />
            <ui:VisualElement class="modal__actions">
                <ui:Button name="fail-ok" class="btn btn--primary" focusable="true" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

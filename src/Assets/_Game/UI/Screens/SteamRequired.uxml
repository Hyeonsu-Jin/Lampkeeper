<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <!-- SCR-001 Steam 실행 필요 안내. 글자는 SteamRequiredView가 텍스트 키로 채운다(NFR-034).
         요소 번호: 1 title, 2 desc(+status), 3 retry, 5 quit (4는 비워 둠). 공통 스타일(Base.uss)은 패널 루트에 UiTheme이 붙인다. -->
    <Style src="project://database/Assets/_Game/UI/Screens/SteamRequired.uss" />
    <ui:VisualElement name="root" class="screen-backdrop">
        <ui:VisualElement name="modal" class="modal modal--steam-required">
            <ui:Label name="title" class="modal__title" />
            <ui:Label name="desc" class="modal__body" />
            <ui:Label name="status" class="modal__status status--warning is-hidden" />
            <ui:VisualElement name="actions" class="modal__actions">
                <ui:Button name="retry" class="btn btn--primary" focusable="true" />
                <ui:Button name="quit" class="btn" focusable="true" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

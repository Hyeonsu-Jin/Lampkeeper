/* =============================================================
   Base.uss  -  UI 공통 기반 (접근성 기반, M1부터)
   역할  : (1) 색 토큰(다크 단일 테마)  (2) 글자 크기 단계 변수  (3) 모양 구분 규칙  (4) 공통 부품(모달, 버튼, 패널, 목록 행, 배지)
   위치  : 패널 루트(UIDocument.rootVisualElement)에 붙인다 (UiTheme.Apply).
   관련  : SDD 3.7.10 (I-04 접근성 기반을 M1 UI부터, I-12 다크 단일 테마), NFR-056, NFR-057, FR-129, FR-130 / STORYBOARD 2.1, 2.2, 2.5, 2.7

   규칙 (USS 규칙 검사 시험 UiRulesTests가 확인한다)
   1) 화면 USS·UXML에서 색 값(rgb, rgba, #..., 색 이름)을 직접 쓰지 않고 var(--color-*)만 쓴다. 색 값은 이 파일의 :root 안에만 있다.
   2) 글자 크기는 var(--fs-*)로만 지정한다(고정 px 금지). 단계 클래스(text-small/normal/large)가 변수 값을 바꾼다.
   3) 색으로 구분하는 상태(.status--X)에는 모양·글자를 함께 쓴다: 짝이 되는 .status-icon--X 가 있어야 하고, 화면은 UiGlyphs 기호를 앞에 붙인다.
   4) 다크 단일 테마. 테마 전환 구조(라이트 토큰, 테마 선택 클래스)는 만들지 않는다.
   ============================================================= */

:root {
    /* 색 토큰 (STORYBOARD 2.1, 다크 한 벌) */
    --color-bg: rgb(14, 16, 20);
    --color-backdrop: rgba(0, 0, 0, 0.88);
    --color-surface: rgb(20, 21, 26);              /* STORYBOARD --panel #14151A */
    --color-surface-raised: rgb(44, 46, 54);
    --color-border: rgb(88, 92, 104);
    --color-text: rgb(232, 228, 220);              /* #E8E4DC */
    --color-text-dim: rgb(169, 165, 156);          /* #A9A59C */
    --color-ally: rgb(109, 184, 240);              /* 동료 표시(◆ 기호와 이름을 함께) */
    --color-enemy: rgb(229, 89, 79);
    --color-warning: rgb(242, 165, 58);            /* #F2A53A */
    --color-danger: rgb(229, 89, 79);              /* #E5594F */
    --color-light: rgb(242, 165, 58);              /* 빛: 선택·포커스·활성·주 버튼 */
    --color-pure: rgb(111, 209, 176);              /* 정화·성공·연결됨 */
    --color-stamina: rgb(168, 212, 90);            /* 스태미나 #A8D45A */
    --color-sand: rgb(216, 203, 176);              /* 허기·갈증·피로도 */
    --color-track: rgb(44, 46, 54);                /* 게이지 빈 부분 */
    --color-disabled: rgb(107, 106, 102);
    --color-focus: rgb(242, 165, 58);
    --color-primary: rgb(242, 165, 58);
    --color-primary-text: rgb(20, 21, 26);

    /* 글자 크기 (기본 = text-normal, 1080p 기준 STORYBOARD 2.2). 단계 클래스가 아래 값을 바꾼다 */
    --fs-caption: 20px;
    --fs-body: 24px;
    --fs-button: 24px;
    --fs-heading: 30px;
    --fs-hud: 22px;
}

/* 글자 크기 단계(작게 ×0.9 / 보통 ×1.0 / 크게 ×1.25): 패널 루트에 하나만 붙는다. 하위 요소는 변수를 상속한다 */
.text-small {
    --fs-caption: 18px;
    --fs-body: 22px;
    --fs-button: 22px;
    --fs-heading: 27px;
    --fs-hud: 20px;
}

.text-normal {
    --fs-caption: 20px;
    --fs-body: 24px;
    --fs-button: 24px;
    --fs-heading: 30px;
    --fs-hud: 22px;
}

.text-large {
    --fs-caption: 25px;
    --fs-body: 30px;
    --fs-button: 30px;
    --fs-heading: 38px;
    --fs-hud: 28px;
}

/* 공통: 숨김 */
.is-hidden {
    display: none;
}

/* 공통: 전체 화면 어두운 배경 (모달 뒤) */
.screen-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--color-backdrop);
    align-items: center;
    justify-content: center;
}

/* 공통: 화면 전체를 채우되 입력을 가로채지 않는 층(HUD) */
.screen-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* 공통: 모달 상자 */
.modal {
    background-color: var(--color-surface);
    border-width: 2px;
    border-color: var(--color-border);
    border-radius: 8px;
    padding: 32px;
}

.modal__title {
    color: var(--color-text);
    font-size: var(--fs-heading);
    -unity-font-style: bold;
    margin-bottom: 16px;
    white-space: normal;
}

.modal__body {
    color: var(--color-text);
    font-size: var(--fs-body);
    white-space: normal;
    margin-bottom: 12px;
}

/* 상태 문구: 색만이 아니라 굵기와 기호로도 구분한다 (모양 구분 규칙) */
.modal__status {
    color: var(--color-text);
    font-size: var(--fs-body);
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: 12px;
}

.status--warning {
    color: var(--color-warning);
}

.status--danger {
    color: var(--color-danger);
}

.status--ok {
    color: var(--color-pure);
}

/* 모양 구분 짝: 색 상태마다 기호 글자 앞에 붙이는 요소의 자리(UiGlyphs 기호를 넣는다) */
.status-icon--warning,
.status-icon--danger,
.status-icon--ok {
    -unity-font-style: bold;
    margin-right: 8px;
}

.modal__actions {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 16px;
}

/* 공통: 반투명 패널 (글자가 올라가는 패널은 불투명도 0.72 이상, STORYBOARD 2.1) */
.panel {
    background-color: var(--color-surface);
    opacity: 0.88;
    border-radius: 8px;
    padding: 12px 16px;
}

.panel__title {
    color: var(--color-text);
    font-size: var(--fs-body);
    -unity-font-style: bold;
    white-space: normal;
}

.text-body {
    color: var(--color-text);
    font-size: var(--fs-body);
    white-space: normal;
}

.text-dim {
    color: var(--color-text-dim);
    font-size: var(--fs-caption);
    white-space: normal;
}

.text-hud {
    color: var(--color-text);
    font-size: var(--fs-hud);
    -unity-font-style: bold;
}

/* 공통: 버튼. 포커스는 굵은 테두리로 드러낸다 (색에만 의존하지 않음). 최소 높이 56 (STORYBOARD 2.3) */
.btn {
    font-size: var(--fs-button);
    color: var(--color-text);
    background-color: var(--color-surface-raised);
    border-width: 2px;
    border-color: var(--color-border);
    border-radius: 6px;
    padding: 10px 24px;
    margin-left: 12px;
    min-width: 140px;
    min-height: 56px;
}

.btn:hover {
    border-color: var(--color-text-dim);
}

.btn:focus {
    border-width: 4px;
    border-color: var(--color-focus);
}

.btn:disabled {
    color: var(--color-disabled);
}

.btn--primary {
    background-color: var(--color-primary);
    color: var(--color-primary-text);
}

.btn--danger {
    color: var(--color-danger);
    border-color: var(--color-danger);
}

/* 공통: 목록 행 (아이콘 기호 + 이름 + 상태 글자). 포커스는 굵은 테두리 */
.list-row {
    flex-direction: row;
    align-items: center;
    min-height: 56px;
    padding: 4px 12px;
    margin-bottom: 4px;
    background-color: var(--color-surface-raised);
    border-width: 2px;
    border-color: var(--color-surface-raised);
    border-radius: 6px;
}

.list-row:hover {
    border-color: var(--color-text-dim);
}

.list-row:focus {
    border-width: 4px;
    border-color: var(--color-focus);
}

.list-row__name {
    flex-grow: 1;
    color: var(--color-text);
    font-size: var(--fs-body);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.list-row__state {
    color: var(--color-text-dim);
    font-size: var(--fs-caption);
    margin-left: 12px;
}

/* 공통: 「게임 진행 중」 배지 (창 오른쪽 위, 게임은 멈추지 않는다 — I-07) */
.badge-running {
    color: var(--color-pure);
    font-size: var(--fs-caption);
    -unity-font-style: bold;
    position: absolute;
    right: 16px;
    top: 12px;
}

/* 공통: 진행 막대 (색 + 채운 비율 + 숫자) */
.gauge {
    height: 16px;
    background-color: var(--color-track);
    border-radius: 8px;
    overflow: hidden;
}

.gauge__fill {
    height: 100%;
    background-color: var(--color-light);
}

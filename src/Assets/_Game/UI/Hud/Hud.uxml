<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <!-- 게임 HUD (SCR-015) M1 범위: 스태미나 호(⑱), 접속자 명단(개발용), 게임 메뉴(Gameplay/Overlay 시험).
         글자는 GameHudView가 텍스트 키로 채운다. 색·글자 크기는 Base.uss 변수만 쓴다. -->
    <Style src="project://database/Assets/_Game/UI/Hud/Hud.uss" />
    <ui:VisualElement name="hud-root" class="screen-layer" picking-mode="Ignore">
        <!-- ⑱ 스태미나 호: 십자선 둘레 얇은 호. 가운데 십자선 ① 포함 -->
        <ui:VisualElement name="crosshair" class="hud-crosshair" picking-mode="Ignore" />
        <ui:VisualElement name="stamina-arc" class="hud-stamina" picking-mode="Ignore" />
        <ui:Label name="stamina-warn" class="hud-stamina-warn status--warning is-hidden" picking-mode="Ignore" />

        <!-- 접속자 명단(개발용, 우상단) -->
        <ui:VisualElement name="roster-panel" class="panel hud-roster" picking-mode="Ignore">
            <ui:Label name="roster-title" class="panel__title" picking-mode="Ignore" />
            <ui:Label name="roster-list" class="text-body" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- 연결 상태 한 줄(개발용, 좌상단) -->
        <ui:Label name="net-status" class="text-dim hud-net-status" picking-mode="Ignore" />

        <!-- 게임 메뉴(Overlay 시험). 열어도 게임은 계속 진행된다(I-07) -->
        <ui:VisualElement name="menu-backdrop" class="screen-backdrop menu-backdrop is-hidden">
            <ui:VisualElement name="menu-panel" class="modal">
                <ui:Label name="menu-badge" class="badge-running" />
                <ui:Label name="menu-title" class="modal__title" />
                <ui:Label name="menu-desc" class="modal__body" />
                <ui:VisualElement class="modal__actions">
                    <ui:Button name="menu-invite" class="btn" focusable="true" />
                    <ui:Button name="menu-leave" class="btn btn--danger" focusable="true" />
                    <ui:Button name="menu-close" class="btn btn--primary" focusable="true" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

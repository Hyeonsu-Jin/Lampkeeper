/* 게임 HUD - 화면 전용 스타일 (색·글자 크기는 Base.uss 변수만 사용). 1920x1080 기준 좌표, 가장자리 여백 40px */

/* ① 십자선: 정중앙 작은 점 */
.hud-crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 8px;
    height: 8px;
    margin-left: -4px;
    margin-top: -4px;
    border-radius: 4px;
    background-color: var(--color-text);
    border-width: 1px;
    border-color: var(--color-surface);
}

/* ⑱ 스태미나 호: 십자선 둘레(지름 약 80px). 그리기는 StaminaArcElement가 한다 */
.hud-stamina {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 80px;
    height: 80px;
    margin-left: -40px;
    margin-top: -40px;
}

/* 스태미나 25% 이하: 점선 호 옆에 경고 기호 + 글자(색에만 의존하지 않음) */
.hud-stamina-warn {
    position: absolute;
    left: 50%;
    top: 50%;
    margin-left: 52px;
    margin-top: -14px;
    font-size: var(--fs-caption);
    -unity-font-style: bold;
}

.hud-roster {
    position: absolute;
    right: 40px;
    top: 40px;
    min-width: 280px;
}

.hud-net-status {
    position: absolute;
    left: 40px;
    top: 40px;
}

.menu-backdrop {
    background-color: var(--color-backdrop);
}

#!/bin/sh
# 커밋 메시지 첫 줄을 CLAUDE.md "커밋 메시지 규칙"대로 검사한다. (IMP-011)
# 설치: 저장소 루트에서 한 번 실행 → git config core.hooksPath tools/git
# 검사: 타입(범위): 제목 형식, 첫 줄 50자 이내, 제목 첫 글자 대문자, 끝 마침표 금지.
# 병합(Merge), 되돌리기(Revert), fixup!/squash! 커밋은 검사하지 않는다.

first=$(sed -n '/^[^#]/{p;q;}' "$1")

case "$first" in
  Merge\ *|Revert\ *|fixup!*|squash!*) exit 0 ;;
esac

fail() {
  echo "commit-msg: $1" >&2
  echo "  첫 줄: $first" >&2
  exit 1
}

echo "$first" | grep -Eq '^(feat|fix|docs|style|refactor|test|chore)(\([a-z0-9-]+\))?: .+' \
  || fail "형식은 '타입(범위): 제목' 이어야 합니다. 타입: feat fix docs style refactor test chore"

len=$(printf '%s' "$first" | wc -m | tr -d ' ')
[ "$len" -le 50 ] || fail "첫 줄이 ${len}자입니다. 50자 이내로 줄이세요."

subject=${first#*: }
echo "$subject" | grep -Eq '^[A-Z]' || fail "제목은 대문자로 시작하는 영어 명령문이어야 합니다."

case "$first" in
  *.) fail "제목 끝에 마침표를 붙이지 않습니다." ;;
esac

exit 0
